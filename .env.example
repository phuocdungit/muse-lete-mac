# Secrets: set these in Botkeep's Environment panel, never commit a real .env.
TELEGRAM_BOT_TOKEN=
# Required (at least 24 random characters) when binding outside loopback.
FOXPROFILE_API_TOKEN=

# Optional. Paths are relative to muse_telebot and foxprofile/data respectively.
MUSE_UPLOAD_DIR=../Videos/downloads/muse_telebot
FOXPROFILE_UPLOAD_DIRS=../../Videos/downloads
FOXPROFILE_API_HOST=127.0.0.1
FOXPROFILE_API_PORT=8090
FOXPROFILE_URL=http://127.0.0.1:8090
NO_PROXY=127.0.0.1,localhost
# Headless mode works without Xvfb; virtual requires Xvfb installed by the host.
# FOXPROFILE_HEADLESS=true
